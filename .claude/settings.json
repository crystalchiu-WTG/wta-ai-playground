{
  "_comment": "Permissions for the WTA PrimeVue component library. Pre-approves common safe operations so non-engineers aren't approving prompts constantly. In-scope edits are limited to src/** and playground/**.",

  "permissions": {
    "allow": [
      "Read",

      "Edit(src/**)",
      "Edit(playground/**)",
      "Edit(CLAUDE.md)",
      "Write(src/**)",
      "Write(playground/**)",

      "Bash(npm run dev)",
      "Bash(npm run dev:*)",
      "Bash(npm run build)",
      "Bash(npm run preview)",

      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b prototype/*)",
      "Bash(git add src/*)",
      "Bash(git add playground/*)",
      "Bash(git commit -m:*)"
    ],

    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout main)",
      "Bash(git checkout master)",
      "Bash(rm -rf:*)",
      "Bash(rm -f:*)",
      "Bash(sudo:*)",

      "Edit(package.json)",
      "Edit(package-lock.json)",
      "Edit(vite.config.js)",
      "Write(package.json)",
      "Write(package-lock.json)",
      "Write(vite.config.js)"
    ]
  }
}
